<!-- views/encyclopedia-tag.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= tag.charAt(0).toUpperCase() + tag.slice(1) %> Pokémon Cards – Tag Encyclopedia</title>
  <meta name="description" content="Explore all Pokémon cards tagged with '<%= tag %>'. Browse our dynamic tag encyclopedia to discover the best <%= tag %> cards.">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/encyclopedia.css"> <!-- optional new file -->
</head>
<body>
  <main class="encyclopedia-wrapper">
    <section class="encyclopedia-hero">
      <h1><%= tag.charAt(0).toUpperCase() + tag.slice(1) %> Pokémon Cards</h1>
      <p class="encyclopedia-subtext">These cards have been tagged by users as "<strong><%= tag %></strong>".</p>
    </section>

    <section class="encyclopedia-summary">
      <p><%= cards.length %> total uses of this tag across <%= uniqueCards %> unique cards.</p>

    </section>

    <section class="encyclopedia-card-grid">
      <% cards.forEach(card => { %>
        <div class="card-tile card-click" data-card-id="<%= card.id %>">
            <img src="<%= card.images?.small || card.images?.large || '/img/no-image.png' %>" alt="<%= card.name %>">
            <p><%= card.name %></p>
        </div>
      <% }) %>
    </section>
  </main>
</body>
</html>
