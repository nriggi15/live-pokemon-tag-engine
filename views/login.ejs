<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login</title>
  <style>
    input, .login-container button {
      box-sizing: border-box;
    }

    body {
      font-family: sans-serif;
      background-color: #f2f4f8;
      padding: 2rem;
      margin: 0;
    }

    .login-container {
      max-width: 400px;
      margin: 0 auto;
      background: #fff;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(0,0,0,0.05);
    }


    input {
      width: 100%;
      padding: 8px;
      margin: 8px 0;
    }

    .login-container button {
      width: 100%;
      padding: 8px;
      margin: 8px 0;
    }
  </style>

  <link rel="stylesheet" href="/style.css" />
  
</head>
<body>

  <div class="login-container" id="login-container">

  <h2>🔐 Login</h2>
  <form id="loginForm" action="/api/login" method="POST">
    <input type="email" id="email" name="email" placeholder="Email" required />
    <input type="password" id="password" name="password" placeholder="Password" required />
    <button type="submit">Log In</button>
    <p id="response"></p>
    <p id="loginMessage"></p> <!-- ✅ Message display area -->
  </form>
  
  <p style="text-align: right; margin-top: -0.5rem;">
    <a href="/forgot-password">Forgot password?</a>
  </p>

  <p id="login-error" style="color: red;"></p>

  <!-- Resend section (hidden by default) -->
  <div id="resend-section" style="display: none;">
    <p>Didn’t get the email?</p>
    <button id="resend-button">Resend Verification Email</button>
    <p id="resend-message" style="color: green;"></p>
  </div>


</div>



  <script type="module" src="/js/script.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
