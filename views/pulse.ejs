<div class="pulse-container">
  <h1>🔁 PokéPulse</h1>
  <p class="pulse-sub">The beating heart of the community</p>

  <% if (activity.length === 0) { %>
    <% console.log('🔎 Pulse activity length:', activity.length); %>

    <% console.log('🧪 Pulse activity count:', activity.length); %>

    <p>No activity yet. Be the first to tag a card!</p>
  <% } else { %>
    <%
      const firstTagKeys = new Set();
      activity.forEach(item => {
        if (item.type === 'first_tag') {
          firstTagKeys.add(`${item.cardId}-${item.user._id}`);
        }
      });
    %>

    <ul class="pulse-feed">
      <% activity.slice(0, 5).forEach(item => { console.log('🔍', item.type, item.status, item.cardId, item.user?.username); }) %>

    <% activity.forEach(item => {
      const tagKey = `${item.cardId}-${item.user._id}`;
      const isDuplicateTag = item.type === 'tag' && firstTagKeys.has(tagKey);
      const isUnapproved = (item.type === 'tag' || item.type === 'first_tag') && item.status !== 'approved';

      if (true) {

    %>


<% console.log('🔍 Rendering item:', item.type, item.cardId, item.tag, item.status); %>

      <li class="pulse-item">
        <div class="pulse-text">
          <% if (item.type === 'first_tag') { %>

              <strong><a href="/user/<%= item.user.username %>"><%= item.user.username %></a></strong>
              added the very first tag on
              <a href="/card/<%= item.cardName %>"><%= item.cardName %></a>:
              <span class="tag">#<%= item.tag %></span>
              <span class="badge">🆕 First tag!</span>

            <% } else if (item.type === 'join') { %>
              just joined! 🎉
            <% } else if (item.type === 'login') { %>
              logged in for the first time 👋
            <% } else if (item.type === 'collection') { %>
              added a new collection!
            <% } else if (item.type === 'badge') { %>
              earned a badge 🏅
            <% } else { %>
              <%= item.message %>
            <% } %>
            <span class="timeago"><%= new Date(item.createdAt).toLocaleTimeString() %></span>
          </div>
          <%
            let imgUrl = '';
            if (item.cardId && item.cardId.includes('-')) {
              const parts = item.cardId.split('-');
              const set = parts[0];
              const number = parts[1];
              imgUrl = `https://images.pokemontcg.io/${set}/${number}_hires.png`;
            }
          %>

          <a href="/card/<%= item.cardId %>">
            <img src="<%= imgUrl %>" alt="card preview" class="card-preview">
          </a>

        </li>
        <% } }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/bottom-nav', { isLoggedIn: isLoggedIn, role: role }) %>
