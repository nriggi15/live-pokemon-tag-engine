<div class="pulse-container">
  <h1>🔁 PokéPulse</h1>
  <p class="pulse-sub">The beating heart of the community</p>

  <% if (activity.length === 0) { %>
    <% console.log('🔎 Pulse activity length:', activity.length); %>

    <% console.log('🧪 Pulse activity count:', activity.length); %>

    <p>No activity yet. Be the first to tag a card!</p>
  <% } else { %>
    <%
      const firstTagKeys = new Set();
      activity.forEach(item => {
        if (item.type === 'first_tag') {
          firstTagKeys.add(`${item.cardId}-${item.user._id}`);
        }
      });
    %>

    <ul class="pulse-feed">
      <%- include('partials/pulse-items', { activity }) %>
    </ul>
    <div id="pulse-loader" style="text-align:center; padding: 2rem; display:none;">
      <p>Loading more activity...</p>
    </div>
    <div id="pulse-end" style="text-align:center; padding: 2rem; display:none;">
      <p>🎉 You've reached the end of the feed.</p>
    </div>

    <button id="backToTop" style="
      position: fixed;
      bottom: 80px;
      right: 40px;
      padding: 0.75rem 1.25rem;
      background: #fecd4c;
      color: #000;
      border: none;
      border-radius: 999px;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      display: none;
      z-index: 1000;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
    ">
      ↑ Top
    </button>


  <% } %>
</div>

<%- include('partials/bottom-nav', { isLoggedIn: isLoggedIn, role: role }) %>
<script type="module" src="/js/script.js"></script>

<script>
  function timeAgo(date) {
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours   = Math.floor(minutes / 60);
    const days    = Math.floor(hours / 24);

    if (seconds < 60) return 'just now';
    if (minutes < 60) return `${minutes} minute${minutes !== 1 ? 's' : ''} ago`;
    if (hours < 24)   return `${hours} hour${hours !== 1 ? 's' : ''} ago`;
    if (days < 7)     return `${days} day${days !== 1 ? 's' : ''} ago`;

    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  }

    let currentPage = 1;
    let loading = false;
    let endReached = false;

    async function loadMorePulse() {
      if (loading || endReached) return;

      const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 500;
      if (!nearBottom) return;

      loading = true;
      document.getElementById('pulse-loader').style.display = 'block';

      currentPage++;
      try {
        const res = await fetch(`/pulse?page=${currentPage}`, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await res.text();

        if (html.trim()) {
          document.querySelector('.pulse-feed').insertAdjacentHTML('beforeend', html);

          // Re-render timestamps
          document.querySelectorAll('.timeago').forEach(el => {
            const raw = el.dataset.time;
            const parsed = new Date(raw);
            if (!isNaN(parsed)) {
              el.textContent = timeAgo(parsed);
            }
          });
        } else {
          // No more content
          endReached = true;
          document.getElementById('pulse-end').style.display = 'block';
        }
      } catch (err) {
        console.error('Error loading more pulse:', err);
      }

      document.getElementById('pulse-loader').style.display = 'none';
      loading = false;
    }

    window.addEventListener('scroll', loadMorePulse);

    const backToTop = document.getElementById('backToTop');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 600) {
        backToTop.style.display = 'block';
      } else {
        backToTop.style.display = 'none';
      }
    });

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });



  document.querySelectorAll('.timeago').forEach(el => {
    const raw = el.dataset.time;
    const parsed = new Date(raw);
    if (!isNaN(parsed)) {
      el.textContent = timeAgo(parsed);
    } else {
      el.textContent = '⏰';
    }
  });
</script>

